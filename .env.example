# MongoDB Atlas: use a database user with a strong password and URL-encode special characters.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/strikegrid?retryWrites=true&w=majority

# Generate a long, random value. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Created when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<your-token>
